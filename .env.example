# ══════════════════════════════════════════════════════════════════════════════
#  Merchant Agent Commerce Infrastructure — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── Razorpay (Test Mode) ───────────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com → Settings → API Keys → Test Keys
# Format: rzp_test_XXXXXXXXXXXXXXXXXXXX
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_SECRET

# ── Google AI (Gemini) ─────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
# Used for: intent parsing, upsell reasoning, semantic catalog embeddings
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_KEY

# ── Agent Network ──────────────────────────────────────────────────────────
# URLs where each agent listens (change only if you use different ports)
MERCHANT_AGENT_URL=http://localhost:8000
BUYER_AGENT_URL=http://localhost:8001
MERCHANT_AGENT_PORT=8000
BUYER_AGENT_PORT=8001

# ── AP2 Mandate Cryptography ───────────────────────────────────────────────
# Shared HMAC-SHA256 secret for signing AP2 Bounded Mandates.
# Change this to a long random string in production.
AP2_MANDATE_SECRET=change_me_to_a_long_random_secret_in_production
